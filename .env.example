# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Default Dio base URL (used for Hadith API & general HTTP)
API_BASE_URL=https://alquranbd.com/api/

# Masjid finder.
#
# GOOGLE_PLACES_API_KEY is read at runtime from this file and is what finds the
# nearby mosques. The Maps SDK key that renders the map itself is a *build*
# setting, not a runtime one — put it in android/local.properties as
# GOOGLE_MAPS_API_KEY (and in ios/Runner/AppDelegate.swift for iOS).
#
# Both can be the same key. Restrict it to the Maps SDK for Android/iOS and the
# Places API, and lock it to this app's package name and signing certificate.
#
# Walking routes use OSRM, which is free and needs no key.
GOOGLE_PLACES_API_KEY=
