<?xml version="1.0" encoding="utf-8"?>
<!-- The window behind Flutter while the engine starts.

     Ivory with the brand mark centred, so the launch reads as the app rather
     than as a white flash followed by the app. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/dusk_ivory" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
